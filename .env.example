# ==========================================================
# SAHAYAK — JAGO AI ASSISTANT CONFIGURATION
# ==========================================================

# ----------------------------------------------------------
# OPTION 1: xAI Grok (Default / Recommended)
# Get your API key from: https://console.x.ai/
# ----------------------------------------------------------
GROK_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-2-latest
GROK_API_URL=https://api.x.ai/v1/chat/completions

# ----------------------------------------------------------
# OPTION 2: OpenAI (ChatGPT)
# Get your API key from: https://platform.openai.com/api-keys
# Uncomment to use OpenAI instead of Grok:
# ----------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# GROK_MODEL=gpt-4o-mini
# GROK_API_URL=https://api.openai.com/v1/chat/completions

# ----------------------------------------------------------
# OPTION 3: Groq (Ultra-fast, free tier available)
# Get your free key from: https://console.groq.com/keys
# Uncomment to use Groq:
# ----------------------------------------------------------
# GROQ_API_KEY=gsk_your-groq-key-here
# GROK_MODEL=llama-3.3-70b-versatile
# GROK_API_URL=https://api.groq.com/openai/v1/chat/completions

# ----------------------------------------------------------
# SERVER & CORS SETTINGS
# ----------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
HOST=0.0.0.0
PORT=8000
